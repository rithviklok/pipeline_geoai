# Copy this file to `.env` and replace the placeholder values with your keys.
# DO NOT commit real credentials.
#
# These are ONLY required for the optional pipeline steps:
#   - parse_addresses (LLM address parsing) -> LLM_* gateway vars below
#   - geocode (Google Maps geocoding)       -> GOOGLE_MAPS_API_KEY
# The default run (load -> match -> defaulters -> report) needs none of them.
#
# The pipeline reads these from environment variables. Set them in your shell,
# e.g. on Windows PowerShell:
#   $env:LLM_API_KEY = "..."
#   $env:GOOGLE_MAPS_API_KEY = "..."
# or on macOS/Linux:
#   export LLM_API_KEY="..."
#   export GOOGLE_MAPS_API_KEY="..."

# --- LLM gateway (OpenAI-compatible) for the parse_addresses step ---
LLM_API_KEY=your-gateway-api-key-here
LLM_BASE_URL=http://35.154.241.163:8502
LLM_PROVIDER=airawat
LLM_MODEL=qwen3-30b-a3b-instruct

# --- Google Maps for the geocode step ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
